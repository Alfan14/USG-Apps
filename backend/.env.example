# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (Example: PostgreSQL / MySQL / MongoDB)
DATABASE_URL=mysql://localhost:3306/nama_database_kamu

# Security & Authentication (Ganti dengan string acak dan kuat di file .env asli)
JWT_SECRET=your_jwt_secret_key_here
DEVICE_SECRET_KEY=your_device_secret_key_here

TRUST_PROXY=1
CLAIM_WINDOW_HOURS=72
TRUST_PROXY=0