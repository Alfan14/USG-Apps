# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Bundled assets (must be placed manually — not committed to git)
/ffmpeg/
/runtime/

# Local recordings and SQLite database
/storage/videos/
/storage/*.db

# Installer output
/installer/dist/

# Environment secrets
.env.local

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
