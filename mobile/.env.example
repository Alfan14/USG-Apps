# Base URL Backend API untuk usg-mobile
# Ganti dengan IP LAN perangkat host (laptop/server) Anda saat menjalankan di HP fisik via Expo Go.
# Cari IP LAN dengan menjalankan 'ipconfig' di terminal (lihat IPv4 Wi-Fi).

EXPO_PUBLIC_API_URL=http://192.168.0.153:4000/api/v1
EXPO_PUBLIC_BACKEND_IP=192.168.0.153
EXPO_PUBLIC_BACKEND_PORT=4000
